<?php

use Drupal\node\NodeInterface;
use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_mail().
 */
function purchase_order_notify_mail($key, &$message, $params) {
  $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';

  switch ($key) {

    case 'purchase_order_fulfilled':
      $message['subject'] = 'Purchase Order Fulfilled';
      $message['body'][] = \Drupal::service('renderer')->renderPlain([
        '#theme' => 'purchase_order_fulfilled',
        '#username' => $params['username'],
        '#po_title' => $params['po_title'],
        '#po_link' => $params['po_link'],
        '#pdf_link' => $params['pdf_link'],
        '#pdf_available' => !empty($params['attachment']),
      ]);
      break;

    case 'quotation_accepted':
      $message['subject'] = 'Quotation Accepted';
      $message['body'][] = \Drupal::service('renderer')->renderPlain([
        '#theme' => 'quotation_accepted',
        '#username' => $params['username'],
        '#quotation_title' => $params['quotation_title'],
        '#quotation_pdf' => $params['quotation_pdf'],
        '#pdf_available' => !empty($params['attachment']),
      ]);
      break;

    case 'restock_raw_material':
      $message['subject'] = 'Inventory Restock Reminder';
      $message['body'][] = \Drupal::service('renderer')->renderPlain([
        '#theme' => 'restock_raw_material',
        '#item_title' => $params['item_title'],
        '#item_link' => $params['item_link'],
      ]);
      break;
  }
}

/**
 * Implements hook_theme().
 */
function purchase_order_notify_theme() {
  return [
    'purchase_order_fulfilled' => [
      'variables' => [
        'username' => NULL,
        'po_title' => NULL,
        'po_link' => NULL,
        'pdf_link' => NULL,
        'pdf_available' => FALSE,
      ],
      'template' => 'mail/purchase_order_fulfilled',
    ],

    'quotation_accepted' => [
      'variables' => [
        'username' => NULL,
        'quotation_title' => NULL,
        'quotation_pdf' => NULL,
        'pdf_available' => FALSE,
      ],
      'template' => 'mail/quotation_accepted',
    ],

    'restock_raw_material' => [
      'variables' => [
        'item_title' => NULL,
        'item_link' => NULL,
      ],
      'template' => 'mail/restock_raw_material',
    ],
  ];
}

/**
 * Implements hook_entity_update().
 *
 * Fires when an entity is updated (after save).
 */
function purchase_order_notify_entity_update(EntityInterface $entity) {
  if (!$entity instanceof NodeInterface) {
    return;
  }

  $bundle = $entity->bundle();

  // ✅ Handle Purchase Order status changes.
  if ($bundle === 'purchase_order') {
    if ($entity->hasField('field_purchase_order_status') && !$entity->get('field_purchase_order_status')->isEmpty()) {
      $term = $entity->get('field_purchase_order_status')->entity;
      if ($term && strcasecmp($term->label(), 'Fulfilled') === 0) {

        // Optional: Only send when the status actually changed.
        if (isset($entity->original)) {
          $old_term = $entity->original->get('field_purchase_order_status')->entity ?? NULL;
          if ($old_term && $old_term->id() == $term->id()) {
            // Status didn’t change, skip.
            return;
          }
        }

        \Drupal::service('purchase_order_notify.mail_service')->sendPurchaseOrderFulfilledMail($entity);
      }
    }
  }

  // ✅ Handle Quotation (moderation-based status).
  if ($bundle === 'quotation') {
    if ($entity->hasField('moderation_state')) {
      $current_state = $entity->get('moderation_state')->value;

      // Check if it changed to "accepted".
      if (strcasecmp($current_state, 'accepted') === 0) {
        if (isset($entity->original)) {
          $old_state = $entity->original->get('moderation_state')->value ?? NULL;
          if ($old_state === $current_state) {
            // State didn't change → skip.
            return;
          }
        }

        // Send the email when moderation_state changes to Accepted.
        \Drupal::service('purchase_order_notify.mail_service')->sendQuotationAcceptedMail($entity);
      }
    }
  }

  // ✅ Handle Inventory Item (Reorder Level based status).
  if ($bundle === 'inventory_item') {
    if ($entity->hasField('field_reorder_level') && !$entity->get('field_reorder_level')->isEmpty()) {
      $field_inventory_type_name = 'field_inventory_type';
      $inventory_type_term = $entity->get($field_inventory_type_name)->entity;
      if ($inventory_type_term) {
        $first_tid = $inventory_type_term->id();
        $first_name = $inventory_type_term->label();
      }

      if($first_name == 'Raw Material'){
        $current_stock = 0;
        $reorder_level = 0;
        if(!$entity->get('field_opening_stock')->isEmpty()){
          $current_stock = $entity->get('field_opening_stock')->value;
        }
        if(!$entity->get('field_reorder_level')->isEmpty()){
          $reorder_level = $entity->get('field_reorder_level')->value;

          if($current_stock <= $reorder_level){
            \Drupal::service('purchase_order_notify.mail_service')->sendRestockInventory($entity);
          }

        }
      }
    }

  }
}
