<table width="100%" cellpadding="0" cellspacing="0" 
       style="font-family: Arial, sans-serif; color:#333; line-height:1.6;">
  <tr>
    <td style="padding:20px;">

      <h2 style="font-size:22px; margin-bottom:10px; color:#222;">
        Purchase Order Fulfilled
      </h2>

      <p>Hello <strong>{{ username }}</strong>,</p>

      <p>
        The following Purchase Order has been <strong>fulfilled</strong>. Below are the full details.
      </p>

      <!-- PO Metadata -->
      <table width="100%" cellpadding="0" cellspacing="0" 
             style="border:1px solid #ddd; border-collapse:collapse; margin-top:20px;">
        <tr>
          <td style="padding:10px; background:#f7f7f7; font-weight:bold;">Purchase Order</td>
          <td style="padding:10px;">{{ po_title }}</td>
        </tr>

        <tr>
          <td style="padding:10px; background:#f7f7f7; font-weight:bold;">Issue Date</td>
          <td style="padding:10px;">{{ params.issue_date }}</td>
        </tr>

        <tr>
          <td style="padding:10px; background:#f7f7f7; font-weight:bold;">Due Date</td>
          <td style="padding:10px;">{{ params.due_date }}</td>
        </tr>

        <tr>
          <td style="padding:10px; background:#f7f7f7; font-weight:bold;">Payment Status</td>
          <td style="padding:10px;">{{ params.payment_status }}</td>
        </tr>
      </table>

      <br>

      <!-- Vendor Details -->
      <h3 style="font-size:18px; margin-top:25px;">Vendor Details</h3>

      <table width="100%" cellpadding="0" cellspacing="0" 
             style="border:1px solid #ddd; border-collapse:collapse;">
        <tr>
          <td style="padding:10px; background:#f7f7f7; font-weight:bold;">Vendor</td>
          <td style="padding:10px;">{{ params.vendor_name }}</td>
        </tr>
        <tr>
          <td style="padding:10px; background:#f7f7f7; font-weight:bold;">Address</td>
          <td style="padding:10px;">{{ params.vendor_address|raw }}</td>
        </tr>
        <tr>
          <td style="padding:10px; background:#f7f7f7; font-weight:bold;">GST Number</td>
          <td style="padding:10px;">{{ params.vendor_gst }}</td>
        </tr>
        <tr>
          <td style="padding:10px; background:#f7f7f7; font-weight:bold;">Phone</td>
          <td style="padding:10px;">{{ params.vendor_contact }}</td>
        </tr>
      </table>

      <br>

      <!-- Line Items -->
      <h3 style="font-size:18px; margin-top:25px;">Order Items</h3>

      <table width="100%" cellpadding="0" cellspacing="0" 
             style="border-collapse:collapse; border:1px solid #ddd; margin-top:10px;">
        <tr style="background:#ff4444; color:white; font-weight:bold;">
          <th style="padding:8px; text-align:left;">Item</th>
          <th style="padding:8px; text-align:right;">Qty</th>
          <th style="padding:8px; text-align:right;">Rate</th>
          <th style="padding:8px; text-align:right;">Total</th>
        </tr>

        {% for item in params.items %}
          <tr>
            <td style="padding:8px; border-bottom:1px solid #eee;">{{ item.name }}</td>
            <td style="padding:8px; text-align:right; border-bottom:1px solid #eee;">{{ item.quantity }}</td>
            <td style="padding:8px; text-align:right; border-bottom:1px solid #eee;">₹{{ item.unit_price|number_format(2) }}</td>
            <td style="padding:8px; text-align:right; border-bottom:1px solid #eee;">₹{{ item.total|number_format(2) }}</td>
          </tr>
        {% endfor %}

        <tr>
          <td colspan="3" style="padding:8px; text-align:right; font-weight:bold;">Subtotal</td>
          <td style="padding:8px; text-align:right;">₹{{ params.subtotal|number_format(2) }}</td>
        </tr>

        <tr>
          <td colspan="3" style="padding:8px; text-align:right; font-weight:bold;">Tax</td>
          <td style="padding:8px; text-align:right;">₹{{ params.tax|number_format(2) }}</td>
        </tr>

        <tr style="background:#f7f7f7; font-weight:bold;">
          <td colspan="3" style="padding:8px; text-align:right;">Grand Total</td>
          <td style="padding:8px; text-align:right;">₹{{ params.total|number_format(2) }}</td>
        </tr>
      </table>

      <br><br>

      <a href="{{ pdf_link }}" 
         style="display:inline-block; padding:12px 20px; background:#28a745; color:#fff; 
                text-decoration:none; border-radius:4px; font-size:15px; font-weight:bold;">
        Download Purchase Order PDF
      </a>

      <br><br>

      <p style="font-size:14px; color:#666;">
        Thank you,<br>
        <strong>{{ site_name }}</strong>
      </p>

    </td>
  </tr>
</table>