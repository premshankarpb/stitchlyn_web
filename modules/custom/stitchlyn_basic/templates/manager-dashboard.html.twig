{# 
    Manager Dashboard Template 
    Designed for TV / Large Screen Display
  #}
  
  <div class="dashboard-page-wrapper">
      
      {# --- Top Header --- #}
      <header class="dashboard-header">
          <div class="dashboard-brand">
              <h1>STITCHLYN <span>OPS</span></h1>
          </div>
          <div class="dashboard-clock">
              <div id="clock-time">--:--</div>
              <div id="clock-date">LOADING...</div>
          </div>
      </header>
  
      {# --- Section 1: Critical KPIs (Row 1) --- #}
      {# 
          Logic:
          - Total Orders: General workload.
          - Due Soon (<= 3 Days): Immediate focus required.
          - Overdue: Critical alerts.
      #}
      <div class="kpi-grid">
          
          {# Card 1: Total Pending #}
          <div class="dash-card neutral">
              <span class="kpi-label">Total Outstanding Work Orders</span>
              <span class="kpi-value">{{ total_pending_orders|default('42') }}</span>
              <div class="progress" style="height: 4px; background: rgba(255,255,255,0.1);">
                  <div class="progress-bar bg-primary" role="progressbar" style="width: 60%"></div>
              </div>
          </div>
  
          {# Card 2: Due Soon (Warning) #}
          <div class="dash-card warning">
              <span class="kpi-label">Due Within 3 Days</span>
              <span class="kpi-value">{{ due_soon_orders|default('18') }}</span>
              <small class="text-warning"><i class="fas fa-exclamation-triangle"></i> High Priority</small>
          </div>
  
          {# Card 3: Overdue (Critical) #}
          <div class="dash-card critical">
              <span class="kpi-label">Orders Overdue</span>
              <span class="kpi-value">{{ overdue_orders|default('5') }}</span>
              <small class="text-danger"><i class="fas fa-bell"></i> Immediate Action Required</small>
          </div>
  
      </div>
  
      {# --- Section 2: Monthly Status (Row 2) --- #}
      <h2 class="section-title">Monthly Production Status</h2>
      <div class="monthly-stats-container">
          
          {# Completed #}
          <div class="stat-block completed">
              <div class="stat-info">
                  <h3>Table Cut / Completed</h3>
                  <div class="count">{{ monthly_completed|default('1250') }}</div>
              </div>
              <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
          </div>
  
          {# In Progress #}
          <div class="stat-block process">
              <div class="stat-info">
                  <h3>In Production</h3>
                  <div class="count">{{ monthly_in_progress|default('320') }}</div>
              </div>
              <div class="stat-icon"><i class="fas fa-cog fa-spin"></i></div>
          </div>
  
          {# To Do #}
          <div class="stat-block todo">
              <div class="stat-info">
                  <h3>Not Started</h3>
                  <div class="count">{{ monthly_todo|default('145') }}</div>
              </div>
              <div class="stat-icon"><i class="far fa-clipboard"></i></div>
          </div>
  
      </div>
  
  </div>