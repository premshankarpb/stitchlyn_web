{# Manager Dashboard Template #}
  
  <div class="dashboard-container">
  
      <div class="bento-grid">
  
          {# 1. CLOCK WIDGET (Top Left, Wide) #}
          <div class="bento-card theme-clock span-col-2">
              <div class="d-flex flex-column justify-content-center h-100">
                  <h6 class="text-uppercase text-white-50 fw-bold ls-1 mb-2">Live Floor Status</h6>
                  <div class="d-flex align-items-baseline">
                      <h1 id="clock-time" class="display-3 fw-bold me-3 mb-0">--:--</h1>
                      <span id="clock-date" class="h4 text-white-50 fw-normal">...</span>
                  </div>
              </div>
              <!-- Decorative Circles -->
              <i class="fas fa-industry sticker-icon" style="opacity: 0.05; font-size: 12rem; right: -40px; top: -20px;"></i>
          </div>
  
          {# 2. PENDING ORDERS (Top Right, Standard) #}
          <div class="bento-card theme-info">
              <div>
                  <h6 class="card-label">Pending</h6>
                  <div class="display-value">{{ counts.pending }}</div>
              </div>
              <div class="progress-pill">
                  <div class="bar" style="width: 45%"></div>
              </div>
              <i class="fas fa-clipboard-list sticker-icon"></i>
          </div>
  
          {# 3. DUE SOON (Top Right, Standard) #}
          <div class="bento-card theme-warning">
              <div>
                  <h6 class="card-label">Due < 3 Days</h6>
                  <div class="display-value">{{ counts.due_3_days }}</div>
              </div>
              <div class="progress-pill">
                  <div class="bar" style="width: 65%"></div>
              </div>
              <i class="fas fa-stopwatch sticker-icon"></i>
          </div>
  
          {# 4. CRITICAL OVERDUE (Middle Left, Large Square) #}
          <div class="bento-card theme-critical span-row-2 span-col-2">
              <div class="mt-2">
                  <div class="d-flex align-items-center mb-2">
                      <span class="badge bg-white text-danger px-3 py-2 rounded-pill fw-bold shadow-sm">CRITICAL ALERT</span>
                  </div>
                  <h1 class="display-value" style="font-size: 8rem;">{{ counts.overdue }}</h1>
                  <h3 class="card-label fs-3">Overdue Orders</h3>
                  <p class="text-white-50 mt-2 fs-5" style="max-width: 80%;">These items require immediate action to prevent delivery delays.</p>
              </div>
              <i class="fas fa-exclamation-triangle sticker-icon" style="font-size: 16rem; right: -60px; bottom: -60px; rotate: -20deg;"></i>
          </div>
  
          {# 5. MONTHLY STATS (Bottom, Wide Bar) #}
          <div class="bento-card theme-clean span-col-2 span-row-2">
              <div class="d-flex flex-column h-100 justify-content-center">
                  <h5 class="fw-bold text-dark mb-4 ls-1 text-uppercase">Monthly Production</h5>
                  
                  {# Large Progress Bars with Icons #}
                  
                  <!-- Completed -->
                  <div class="mb-4">
                      <div class="d-flex justify-content-between align-items-end mb-2">
                          <span class="text-success fw-bold"><i class="fas fa-check-circle me-2"></i> Completed</span>
                          <span class="h4 mb-0 fw-black">{{ counts.monthly_production.completed }}</span>
                      </div>
                      <div class="progress" style="height: 12px; border-radius: 99px; background: #dcfce7;">
                          <div class="progress-bar bg-success" style="width: {{ counts.monthly_production.percent.completed }}%; border-radius: 99px;"></div>
                      </div>
                  </div>
  
                  <!-- In Progress -->
                  <div class="mb-4">
                      <div class="d-flex justify-content-between align-items-end mb-2">
                          <span class="text-primary fw-bold"><i class="fas fa-cog fa-spin me-2"></i> In Progress</span>
                          <span class="h4 mb-0 fw-black">{{ counts.monthly_production.in_progress }}</span>
                      </div>
                      <div class="progress" style="height: 12px; border-radius: 99px; background: #dbeafe;">
                          <div class="progress-bar bg-primary" style="width: {{ counts.monthly_production.percent.in_progress }}%; border-radius: 99px;"></div>
                      </div>
                  </div>
  
                   <!-- To Do -->
                   <div>
                      <div class="d-flex justify-content-between align-items-end mb-2">
                          <span class="text-secondary fw-bold"><i class="fas fa-box me-2"></i> To Do</span>
                          <span class="h4 mb-0 fw-black">{{ counts.monthly_production.to_do }}</span>
                      </div>
                      <div class="progress" style="height: 12px; border-radius: 99px; background: #e5e7eb;">
                          <div class="progress-bar bg-secondary" style="width: {{ counts.monthly_production.percent.to_do }}%; border-radius: 99px;"></div>
                      </div>
                  </div>
  
              </div>
          </div>
  
      </div>
  </div>