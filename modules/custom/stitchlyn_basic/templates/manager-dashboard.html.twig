{# 
    Manager Dashboard Template 
    Layout: Masonry Grid
    Theme: Semantic Colors (Pastels)
  #}
  
  <div class="dashboard-container py-4">
  
      {# --- Header --- #}
      <div class="d-flex justify-content-between align-items-center mb-5 ps-2 pe-2">
          <div>
              <h6 class="text-uppercase text-muted fw-bold mb-1 ls-1">Live Overview</h6>
              <h2 class="fw-black mb-0" style="color: #25374e; font-weight: 900;">Production Floor</h2>
          </div>
          <div class="dash-clock-widget d-flex align-items-center">
              <i class="far fa-clock me-2 opacity-75"></i>
              <span id="clock-time" class="fw-bold me-2">--:--</span>
              <span id="clock-date" class="small opacity-75 border-start border-secondary ps-2 text-white-50">...</span>
          </div>
      </div>
  
      {# --- Masonry Grid --- #}
      <div class="masonry-grid">
  
          {# 1. CRITICAL CARD: Overdue #}
          <div class="masonry-item">
              <div class="card kpi-card status-critical h-100">
                  <div class="card-body">
                      <div class="d-flex justify-content-between mb-4">
                          <div class="icon-circle">
                              <i class="fas fa-exclamation-triangle"></i>
                          </div>
                      </div>
                      <div class="mb-3">
                          <h2 class="display-4 mb-0">{{ overdue_orders|default('5') }}</h2>
                          <span class="card-label">Overdue Orders</span>
                      </div>
                      <div class="progress bg-white bg-opacity-50" style="height: 6px;">
                          <div class="progress-bar" role="progressbar" style="width: 100%"></div>
                      </div>
                  </div>
              </div>
          </div>
  
          {# 2. WARNING CARD: Due Soon #}
          <div class="masonry-item">
              <div class="card kpi-card status-warning h-100">
                  <div class="card-body">
                      <div class="d-flex justify-content-between mb-4">
                          <div class="icon-circle">
                              <i class="fas fa-stopwatch"></i>
                          </div>
                      </div>
                      <div class="mb-3">
                          <h2 class="display-4 mb-0">{{ due_soon_orders|default('18') }}</h2>
                          <span class="card-label">Due Within 3 Days</span>
                      </div>
                      <div class="progress bg-white bg-opacity-50" style="height: 6px;">
                          <div class="progress-bar" role="progressbar" style="width: 65%"></div>
                      </div>
                  </div>
              </div>
          </div>
  
          {# 3. INFO CARD: Total Pending #}
          <div class="masonry-item">
              <div class="card kpi-card status-info h-100">
                  <div class="card-body">
                      <div class="d-flex justify-content-between mb-4">
                          <div class="icon-circle">
                              <i class="fas fa-clipboard-list"></i>
                          </div>
                          <span class="badge bg-white text-primary rounded-pill px-3 py-2 shadow-sm">Total Load</span>
                      </div>
                      <div class="mb-3">
                          <h2 class="display-4 mb-0">{{ total_pending_orders|default('42') }}</h2>
                          <span class="card-label">Total Outstanding</span>
                      </div>
                      <div class="progress bg-white bg-opacity-50" style="height: 6px;">
                          <div class="progress-bar" role="progressbar" style="width: 45%"></div>
                      </div>
                  </div>
              </div>
          </div>
  
          {# 4. FEATURE CARD: Monthly Progress #}
          <div class="masonry-item">
              <div class="card kpi-card status-neutral h-100">
                  <div class="card-body p-4">
                      <h5 class="fw-bold text-dark mb-4">Monthly Goal Progress</h5>
                      
                      <!-- Completed -->
                      <div class="d-flex align-items-center mb-3">
                          <div class="flex-grow-1">
                              <div class="d-flex justify-content-between small fw-bold mb-1">
                                  <span class="text-success">COMPLETED</span>
                                  <span class="text-dark">{{ monthly_completed|default('1,250') }}</span>
                              </div>
                              <div class="progress" style="height: 10px;">
                                  <div class="progress-bar bg-success" role="progressbar" style="width: 70%"></div>
                              </div>
                          </div>
                      </div>
  
                      <!-- In Progress -->
                      <div class="d-flex align-items-center mb-3">
                          <div class="flex-grow-1">
                              <div class="d-flex justify-content-between small fw-bold mb-1">
                                  <span style="color: #25374e;">IN PROGRESS</span>
                                  <span class="text-dark">{{ monthly_in_progress|default('320') }}</span>
                              </div>
                              <div class="progress" style="height: 10px;">
                                  <div class="progress-bar" role="progressbar" style="width: 20%; background-color: #25374e;"></div>
                              </div>
                          </div>
                      </div>
  
                      <!-- To Do -->
                      <div class="d-flex align-items-center">
                          <div class="flex-grow-1">
                              <div class="d-flex justify-content-between small fw-bold mb-1">
                                  <span class="text-muted">TO DO</span>
                                  <span class="text-dark">{{ monthly_todo|default('145') }}</span>
                              </div>
                              <div class="progress" style="height: 10px;">
                                  <div class="progress-bar bg-secondary" role="progressbar" style="width: 10%"></div>
                              </div>
                          </div>
                      </div>
  
                  </div>
              </div>
          </div>
  
      </div>
  </div>