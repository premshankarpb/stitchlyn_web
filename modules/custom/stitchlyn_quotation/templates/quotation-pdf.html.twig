<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>{{ invoice_no }}</title>
    <style>
      body { font-family: DejaVu Sans, sans-serif; font-size: 12px; color: #222; }
      .header { width: 100%; border-bottom: 2px solid #e74c3c; margin-bottom: 10px; }
      .left { float: left; width: 70%; }
      .right { float: right; width: 30%; text-align: right; }
      .clearfix { clear: both; }
      .logo { max-height: 70px; }
      table { width: 100%; border-collapse: collapse; margin-top: 15px; }
      th, td { border: 1px solid #ccc; padding: 6px; text-align: left; }
      th { background: #e74c3c; color: #fff; }
      .no-border td { border: none; }
      .totals td { text-align: right; }
      .footer { margin-top: 40px; font-size: 11px; }
      .bold { font-weight: bold; }
    </style>
  </head>
  <body>

    <div class="header">
      <div class="left">
        <h2>TAX INVOICE</h2>
        <p><strong>{{ client_name }}</strong><br>{{ client_address|raw }}<br>
        GSTIN: {{ client_gst }}<br>{{ client_contact }}</p>
      </div>
      <div class="right">
        {% if logo %}
          <img src="{{ logo }}" class="logo" alt="Logo">
        {% endif %}
        <p><strong>Invoice #:</strong> {{ invoice_no }}<br>
        <strong>Issue Date:</strong> {{ issue_date|date("d M Y") }}<br>
        <strong>Due Date:</strong> {{ due_date|date("d M Y") }}</p>
      </div>
      <div class="clearfix"></div>
    </div>

    <h3>Bill To:</h3>
    <table class="bill-to">
      <tr>
        <td>
          <strong>{{ customer_profile.name }}</strong><br>
          {% if customer_profile.billing_address %}
            {{ customer_profile.billing_address }}<br>
          {% endif %}
          {% if customer_profile.phone %}
            Phone: {{ customer_profile.phone }}<br>
          {% endif %}
          {% if customer_profile.email %}
            Email: {{ customer_profile.email }}<br>
          {% endif %}
          {% if customer_profile.gst %}
            GSTIN: {{ customer_profile.gst }}
          {% endif %}
        </td>
      </tr>
    </table>

    <table>
      <thead>
        <tr>
          <th>S.No</th>
          <th>Description</th>
          <th>Unit Price</th>
          <th>Quantity</th>
          <th>Amount</th>
        </tr>
      </thead>
      <tbody>
        {% for item in items %}
          <tr>
            <td>{{ loop.index }}</td>
            <td>{{ item.name }}</td>
            <td>₹{{ item.unit_price|number_format(2, '.', ',') }}</td>
            <td>{{ item.quantity }}</td>
            <td>₹{{ item.total|number_format(2, '.', ',') }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    <table class="totals">
      <tr><td colspan="4" class="no-border"></td><td><strong>Subtotal:</strong> ₹{{ subtotal|number_format(2, '.', ',') }}</td></tr>
      <tr><td colspan="4" class="no-border"></td><td><strong>Discount:</strong> ₹{{ discount|number_format(2, '.', ',') }}</td></tr>
      <tr><td colspan="4" class="no-border"></td><td><strong>Tax ({{ tax_percentage }}%):</strong> ₹{{ tax|number_format(2, '.', ',') }}</td></tr>
      <tr><td colspan="4" class="no-border"></td><td><strong>Total:</strong> ₹{{ total|number_format(2, '.', ',') }}</td></tr>
    </table>

    <div class="footer">
      <p><strong>Bank Details</strong><br>{{ client_banking|raw }}</p>
      <p><strong>Terms & Conditions:</strong><br>1. Payment is due within 14 days.<br>2. Please include invoice number on payment.<br>3. All prices are in INR.</p>
      <p style="text-align:right; margin-top:50px;"><strong>Authorized Signature</strong></p>
    </div>
  </body>
</html>
