<div class="customer-popup-form-wrapper container-fluid">

  <div class="row">

    {# =========================
       LEFT SECTION
       USER ACCOUNT
    ========================== #}

    <div class="col-md-6">

      <div class="card mb-3">
        <div class="card-header">
          <strong>User Account</strong>
        </div>

        <div class="card-body">

          <div class="row">

            <div class="col-md-6 mb-3">
              {{ form.field_first_name }}
            </div>

            <div class="col-md-6 mb-3">
              {{ form.field_last_name }}
            </div>

          </div>

          <div class="mb-3">
            {{ form.email }}
          </div>

          <div class="mb-3">
            {{ form.password }}
          </div>

          <div class="mb-3">
            {{ form.username }}
          </div>

          <div class="mb-3">
            {{ form.field_phone_number }}
          </div>

        </div>
      </div>

    </div>

    {# =========================
       RIGHT SECTION
       CUSTOMER PROFILE
    ========================== #}

    <div class="col-md-6">

      <div class="card mb-3">
        <div class="card-header">
          <strong>Customer Profile</strong>
        </div>

        <div class="card-body">

          <div class="mb-3">
            {{ form.field_billing_address }}
          </div>

          <div class="mb-3">
            {{ form.field_gst_number }}
          </div>

          <div class="row">

            <div class="col-md-6 mb-3">
              {{ form.field_associated_diocese }}
            </div>

            <div class="col-md-6 mb-3">
              {{ form.field_division }}
            </div>

          </div>

          <div class="mb-3">
            {{ form.field_parish }}
          </div>

          <div class="row">

            <div class="col-md-6 mb-3">
              {{ form.field_name_of_referrer }}
            </div>

            <div class="col-md-6 mb-3">
              {{ form.field_referrer_contact }}
            </div>

          </div>

          <div class="row">

            <div class="col-md-6 mb-3">
              {{ form.field_date_of_birth }}
            </div>

            <div class="col-md-6 mb-3">
              {{ form.field_ordination_day }}
            </div>

          </div>

          <div class="mb-3">
            {{ form.field_remarks }}
          </div>

        </div>
      </div>

    </div>

  </div>

  {# =========================
     ACTIONS
  ========================== #}

  <div class="row">
    <div class="col-12 text-end">
      {{ form.actions }}
    </div>
  </div>

  {{ form.form_build_id }}
  {{ form.form_token }}
  {{ form.form_id }}

</div>