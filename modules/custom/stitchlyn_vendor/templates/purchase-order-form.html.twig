<div class="po-form-wrapper">

  {# ================= PURCHASE ORDER DETAILS ================= #}
  <div class="po-details">
    <details data-drupal-selector="edit-po-details"
             id="edit-po-details"
             class="js-form-wrapper form-wrapper olivero-details"
             data-once="details"
             open>

      <summary role="button"
               aria-controls="edit-po-details"
               class="olivero-details__summary">
        {{ form.po_details['#title'] }}
      </summary>

      <div class="olivero-details__wrapper details-wrapper">

        <div class="po-title-block">
          {{ form.po_details.title }}
        </div>

        <div class="po-vendor-block">
          {{ form.po_details.field_vendor }}
        </div>

        <div class="po-date-status-row">

          <div class="po-date-col">
            {{ form.po_details.field_date_of_purchase }}
          </div>

          <div class="po-status-col">
            {{ form.po_details.order_status }}
          </div>

          <div class="po-payment-col">
            {{ form.po_details.payment_status }}
          </div>

        </div>

        <div class="po-remarks-block">
          {{ form.po_details.body }}
        </div>

      </div>
    </details>
  </div>



  {# ================= PURCHASE ITEMS SECTION ================= #}
  <div class="po-items">
    <details data-drupal-selector="edit-po-items"
             id="edit-po-items"
             class="js-form-wrapper form-wrapper olivero-details"
             data-once="details"
             open>

      <summary role="button"
               aria-controls="edit-po-items"
               class="olivero-details__summary">
        {{ form.po_items['#title'] }}
      </summary>

      <div class="olivero-details__wrapper details-wrapper">
        {{ form.po_items.content }}
      </div>

    </details>
  </div>



  {# ================= PURCHASE SUMMARY ================= #}
  <fieldset data-drupal-selector="edit-po-summary"
            id="edit-po-summary"
            class="fieldset js-form-item form-item js-form-wrapper form-wrapper">

    <legend class="fieldset__legend fieldset__legend--visible">
      <span class="fieldset__label">
        {{ form.po_summary['#title'] }}
      </span>
    </legend>

    <div class="fieldset__wrapper">
      <div class="po-summary-row">

        <div class="po-subtotal">
          {{ form.po_summary.field_subtotal_amount }}
        </div>

        <div class="po-tax">
          {{ form.po_summary.field_tax_amount }}
        </div>

        <div class="po-total">
          {{ form.po_summary.field_total_amount }}
        </div>

      </div>
    </div>
  </fieldset>



  {# ================= ACTIONS ================= #}
  <div class="po-actions">
    {{ form.actions }}
  </div>



  {# VERY IMPORTANT: keep hidden elements #}
  {{ form|without(
    'po_details',
    'po_items',
    'po_summary',
    'actions'
  ) }}

</div>