<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Stitchlyn - Invoice</title>
  <style>
    @page { size: A4; margin: 25px; }
    body { font-family: DejaVu Sans, sans-serif; font-size: 12px; color: #333; }
    h1, h3, h4 { margin: 0; padding: 0; }
    table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    th, td { border: 1px solid #ccc; padding: 8px; font-size: 12px; }
    th { background-color: #ff4444; color: #fff; text-align: left; }
    tfoot td { font-weight: bold; }
    .header, .company, .billship { display: flex; justify-content: space-between; margin-bottom: 20px; }
    .signature { margin-top: 50px; text-align: right; }
    .signature div { border-top: 1px solid #666; width: 200px; padding-top: 10px; display: inline-block; }
  </style>
</head>
<body>
  <!-- Header -->
  <div class="header">
    <div>
      <h1>TAX INVOICE</h1>
      <p><strong>Invoice #:</strong> <span style="color:#ff4444;">PO-{{ node.id }}</span></p>
    </div>
    <div style="text-align:right;">
      {% if logo_path is defined %}
        <img src="{{ logo_path }}" style="height:60px;">
      {% endif %}
    </div>
  </div>

  <!-- Company & Issue Details -->
  <div class="company">
    <div>
      <h3>STITCHLYN</h3>
      <p>
        123 Fashion Street, Design District<br>
        Bangalore, Karnataka 560001<br>
        Phone: +91 80 1234 5678<br>
        Email: info@stitchlyn.com<br>
        GSTIN: 29AABCS1234Z1ZX
      </p>
    </div>
    <div style="text-align:right;">
      <p>
        <strong>Issue Date:</strong> {{ node.created.value|date("d-M-Y") }}<br>
        <strong>Due Date:</strong> {{ node.field_due_date.value|date("d-M-Y") }}<br>
        <strong>Place of Supply:</strong> KA (29)
      </p>
    </div>
  </div>

  <!-- Bill To & Ship To -->
  <div class="billship">
    <div>
      <h4>Bill To</h4>
      <p>
        {{ vendor_profile.field_billing_address.value|nl2br }}<br>
        GSTIN: {{ vendor_profile.field_gst_number.value }}
      </p>
    </div>
    <div>
      <h4>Ship To</h4>
      <p>
        {{ vendor_profile.field_shipping_address.value|nl2br }}<br>
        Contact: {{ vendor_profile.field_phone_number.0.phone_number }}
      </p>
    </div>
  </div>

  <!-- Items Table -->
  <table>
    <thead>
      <tr>
        <th>S.No</th>
        <th>Description</th>
        <th style="text-align:right;">Price</th>
        <th style="text-align:right;">Taxable Value</th>
        <th style="text-align:right;">Tax</th>
        <th style="text-align:right;">Amount</th>
      </tr>
    </thead>
    <tbody>
      {% set grand_total = 0 %}
      {% for item in referencing_nodes %}
        {% set sub_total = item.field_quantity.value * item.field_item_rate.value %}
        {% set total_amount = sub_total + item.field_tax_amount.value %}
        {% set grand_total = grand_total + total_amount %}
        <tr>
          <td>{{ loop.index }}</td>
          <td>
            {{ item.field_item_reference.entity.label }}
            {% if item.body.value %}<br><small>{{ item.body.value }}</small>{% endif %}
          </td>
          <td style="text-align:right;">₹{{ item.field_item_rate.value }}</td>
          <td style="text-align:right;">₹{{ sub_total }}</td>
          <td style="text-align:right;">₹{{ item.field_tax_amount.value }}</td>
          <td style="text-align:right;">₹{{ total_amount }}</td>
        </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr>
        <td colspan="5" style="text-align:right;">Total</td>
        <td style="text-align:right;">₹{{ grand_total }}</td>
      </tr>
    </tfoot>
  </table>

  <!-- Bank Details -->
  <div style="margin-top:30px;">
    <h4>Bank Details</h4>
    <p>
      Bank Name: HDFC Bank<br>
      Account Number: 50200086169366<br>
      IFSC Code: HDFC0004896<br>
      Branch: FASHION DISTRICT
    </p>
  </div>

  <!-- Terms -->
  <div style="margin-top:20px;">
    <h4>Terms & Conditions</h4>
    <p style="font-size:11px;">
      1. Payment is due within 14 days<br>
      2. Please include invoice number on payment<br>
      3. All prices are in INR
    </p>
  </div>

  <!-- Signature -->
  <div class="signature">
    <div>
      <p>Authorized Signature</p>
    </div>
  </div>
</body>
</html>
