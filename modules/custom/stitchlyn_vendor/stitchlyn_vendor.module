<?php

/**
 * Implements hook_theme().
 */
function stitchlyn_vendor_theme($existing, $type, $theme, $path) {
  return [
    'vendor_add_form' => [
      'render element' => 'form',
      'template'       => 'vendor-form', // maps to vendor-form.html.twig
      'path'           => $path . '/templates',
    ],
    'stitchlyn_vendor_edit_form' => [
      'render element' => 'form',
      'template'       => 'vendor-edit-form', // maps to vendor-edit-form.html.twig
      'path'           => $path . '/templates',
    ],
    'purchase_order_form' => [
      'render element' => 'form',
      'template'       => 'purchase-order-form',
      'path'           => $path . '/templates',
    ],
    'inventory_item_form' => [
      'render element' => 'form',
      'template'       => 'inventory-item-form',
      'path'           => $path . '/templates',
    ],
    'stitchlyn_inventory_detail' => [
      'variables' => ['node' => NULL],
      'template' => 'inventory-detail',
    ],
    'stitchlyn_po_detail' => [
      'variables' => [
        'node' => NULL,
        'vendor_user' => [],
        'vendor_profile' => [],
        'referencing_nodes' => [],
      ],
      'template' => 'po-detail',
    ],
    'stitchlyn_po_pdf' => [
      'variables' => [
        'node' => NULL,
        'logo' => '',
        'client_name' => '',
        'client_address' => '',
        'client_contact' => '',
        'client_gst' => '',
        'client_banking' => '',
        'tax_percentage' => 0,
        'vendor_profile' => [],
        'referencing_nodes' => [],
        'invoice_no' => '',
        'issue_date' => '',
        'due_date' => '',
        'subtotal' => 0,
        'tax' => 0,
        'total' => 0,
      ],
      'template' => 'po-pdf',
    ],
    'stitchlyn_my_purchase_orders' => [
      'variables' => [
        'node' => NULL
      ],
      'template' => 'my-purchase-orders',
    ],
  ];
}
