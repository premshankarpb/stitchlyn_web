<?php

use Drupal\Core\Menu\MenuTreeParameters;
use Drupal\file\Entity\File;
use Drupal\profile\Entity\Profile;
use Drupal\Core\Url;
use Drupal\Core\Routing\TrustedRedirectResponse;
use Drupal\Core\Site\Settings;

/**
 * Implements hook_preprocess_paragraph__feature_item().
 */
function stitchlyn_theme_preprocess_paragraph(array &$variables) {
  $paragraph = $variables['paragraph'];

  if ($paragraph->bundle() === 'feature_item' || $paragraph->bundle() === 'simple_card_item' ) {
    // Make sure the field_icon is not empty.
    if (!$paragraph->get('field_icon')->isEmpty()) {
      // Get the string value from the text field.
      $icon_value = $paragraph->get('field_icon')->value;

      // Pass it to the Twig template.
      $variables['icon'] = $icon_value;
    }
  }

  if ($paragraph->bundle() === 'st') {
    if (!$paragraph->get('field_stat_number')->isEmpty()) {
      $stat_number = $paragraph->get('field_stat_number')->value;
      $variables['stat_number_value'] = $stat_number;
    }
    if (!$paragraph->get('field_stat_label')->isEmpty()) {
      $stat_label = $paragraph->get('field_stat_label')->value;
      $variables['stat_number_label'] = $stat_label;
    }
  }

  if ($paragraph->bundle() == 'cta_banner') {

    if (!$paragraph->get('field_banner_button_1')->isEmpty()) {
      $link_item = $paragraph->get('field_banner_button_1')->first();
      $url = $link_item->getUrl();
      $title = $link_item->title;

      // Get actual URL as a string.
      $variables['link_url_1'] = $url->toString();
      $variables['link_title_1'] = $title ?: $url->toString(); // fallback to URL if no title
    }
    if (!$paragraph->get('field_banner_button_2')->isEmpty()) {
      $link_item = $paragraph->get('field_banner_button_2')->first();
      $url = $link_item->getUrl();
      $title = $link_item->title;

      // Get actual URL as a string.
      $variables['link_url_2'] = $url->toString();
      $variables['link_title_2'] = $title ?: $url->toString(); // fallback to URL if no title
    }    
  }

  if ($paragraph->bundle() == 'banner_item') {
    if (!$paragraph->get('field_banner_image')->isEmpty()) {
      $image_item = $paragraph->get('field_banner_image')->first();
      $file = \Drupal\file\Entity\File::load($image_item->target_id);
      if ($file) {
        $uri = $file->getFileUri();
        $url = \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
        $variables['banner_item_image_url'] = $url;
      }
    }
  }

  if ($paragraph->bundle() == 'type_a_card_cta') {
    if (!$paragraph->get('field_image')->isEmpty()) {
      $image_item = $paragraph->get('field_image')->first();
      $file = \Drupal\file\Entity\File::load($image_item->target_id);
      if ($file) {
        $uri = $file->getFileUri();
        $url = \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
        $variables['paragraph_image_url'] = $url;
      }
    }
  }

}

/**
 * Implements hook_preprocess_page().
 */
function stitchlyn_theme_preprocess_page(array &$variables) {
  $current_user = \Drupal::currentUser();
  $variables['logged_in'] = $current_user->isAuthenticated();

  $block_manager = \Drupal::service('plugin.manager.block');

  // === MAIN MENU ===
  $menu_tree = \Drupal::menuTree();
  $parameters = new MenuTreeParameters();
  $main_tree = $menu_tree->load('main', $parameters);
  $manipulators = [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ];
  $main_tree = $menu_tree->transform($main_tree, $manipulators);
  $main_menu = $menu_tree->build($main_tree);
  $variables['menus']['main_menu'] = \Drupal::service('renderer')->render($main_menu);

  // === USER ACCOUNT MENU ===
  $account_block = $block_manager->createInstance('system_menu_block:account', []);
  $account_render = $account_block->build();
  $account_render['#cache']['contexts'][] = 'user.roles';
  $variables['menus']['user_account'] = \Drupal::service('renderer')->render($account_render);

  // === BACKEND MENU ===
  $backend_block = $block_manager->createInstance('system_menu_block:backend', []);
  $backend_render = $backend_block->build();
  $backend_render['#cache']['contexts'][] = 'user.roles';

  // Extract menu items from the render array for your custom Twig file
  if (isset($backend_render['#items'])) {
    $variables['page']['backend_menu'] = $backend_render['#items'];
  } else {
    // fallback: use the render array directly
    $variables['page']['backend_menu'] = [];
  }

  // === FOOTER MENU ===
  $footer_block = $block_manager->createInstance('system_menu_block:footer', []);
  $footer_render = $footer_block->build();
  $footer_render['#cache']['contexts'][] = 'user.roles';
  $variables['page']['footer_menu'] = $footer_render['#items'] ?? [];

  // === SUPPORT MENU ===
  $support_block = $block_manager->createInstance('system_menu_block:support', []);
  $support_render = $support_block->build();
  $support_render['#cache']['contexts'][] = 'user.roles';
  $variables['page']['support_menu'] = $support_render['#items'] ?? [];

  // === SOCIAL LINKS MENU ===
  $social_block = $block_manager->createInstance('system_menu_block:social-links', []);
  $social_render = $social_block->build();
  $social_render['#cache']['contexts'][] = 'user.roles';
  $variables['page']['social_links'] = $social_render['#items'] ?? [];
}

/**
 * Helper to convert a menu to a title/url array.
 */
function _stitchlyn_prepare_menu_array($menu_name) {
  $items = [];
  $tree = \Drupal::menuTree()->load($menu_name, new MenuTreeParameters());
  $manipulated = \Drupal::menuTree()->transform($tree, []);
  foreach ($manipulated as $item) {
    if (isset($item->link)) {
      $menu_item = [
        'title' => $item->link->getTitle(),
        'url' => $item->link->getUrlObject()->toString(),
      ];

      // Add children if available
      if (!empty($item->subtree)) {
        $menu_item['children'] = [];
        foreach ($item->subtree as $child) {
          if (isset($child->link)) {
            $menu_item['children'][] = [
              'title' => $child->link->getTitle(),
              'url' => $child->link->getUrlObject()->toString(),
            ];
          }
        }
      }

      $items[] = $menu_item;
    }
  }
  return $items;
}


function stitchlyn_theme_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  if (strpos(\Drupal::request()->getPathInfo(), '/dashboard') === 0) {
    $suggestions[] = 'page__dashboard';
  }
}

/**
 * Implements hook_preprocess_node().
 */
function stitchlyn_theme_preprocess_node(array &$variables) {

  $node = $variables['node'];

  // Ensure this is a node of content type 'product' and has the field
  if ($node instanceof \Drupal\node\NodeInterface && $node->bundle() === 'product' && $node->hasField('field_product_images')) {
    $image_urls = [];

    // Get the referenced image files
    $images = $node->get('field_product_images')->referencedEntities();
    foreach ($images as $image) {
      if ($image instanceof File) {
        // Get file URI (e.g., "public://images/example.jpg")
        $file_uri = $image->getFileUri();

        // Get full absolute URL from file_uri
        //$url = $file_url_generator->generateAbsoluteString($file_uri);
        $url = \Drupal::service('file_url_generator')->generateAbsoluteString($file_uri);
        $image_urls[] = $url;
      }
    }

    // Pass the image URLs to the Twig template
    $variables['product_image_urls'] = $image_urls;
  }

  if ($node instanceof \Drupal\node\NodeInterface && $node->bundle() === 'quotation') {
    $quotation_item_data = [];

    // Query all Quotation Line Item nodes linked to this quotation.
    $query = \Drupal::entityQuery('node')
      ->condition('type', 'quatation_line_items') // your correct type
      ->condition('field_linked_quotation', $node->id())
      ->accessCheck(TRUE)
      ->execute();

    if (!empty($query)) {
      $quotation_items = \Drupal\node\Entity\Node::loadMultiple($query);
      // Load customer info
      $user = NULL;
      $profile = NULL;
      if ($node->hasField('field_customer_reference') && !$node->get('field_customer_reference')->isEmpty()) {
        $user = $node->field_customer_reference->entity;
        $profiles = \Drupal::entityTypeManager()
          ->getStorage('profile')
          ->loadByProperties([
            'uid' => $user->id(),
            'type' => 'customer',
          ]);
        $profile = reset($profiles);
      }

      // Build array for Twig
      foreach ($quotation_items as $item) {
        $product_title = NULL;
        $unit_price = 0;
        $attributes_data = [];

        // Load Product
        if ($item->hasField('field_product') && !$item->get('field_product')->isEmpty()) {
          $product_node = $item->get('field_product')->entity;
          if ($product_node instanceof \Drupal\node\NodeInterface) {
            $product_title = $product_node->label();
            $unit_price = $product_node->get('field_cost_price')->value ?? 0;
          }
        }

        $quantity = $item->get('field_quantity')->value ?? 0;
        $total = $unit_price * $quantity;

        // ✅ Load Attributes Paragraph (if present)
        if ($item->hasField('field_attributes') && !$item->get('field_attributes')->isEmpty()) {
          $attr_field = $item->get('field_attributes')->first();

          // Load paragraph via revision to get all field data
          $paragraph = NULL;
          if (!empty($attr_field->target_revision_id)) {
            $paragraph = \Drupal::entityTypeManager()
              ->getStorage('paragraph')
              ->loadRevision($attr_field->target_revision_id);
          }

          if ($paragraph) {
            $bundle_label = ucfirst(str_replace('_', ' ', $paragraph->bundle()));
            $fields = [];

            foreach ($paragraph->getFields() as $fname => $fval) {
              if (strpos($fname, 'field_') !== 0 || $fval->isEmpty()) continue;

              $label = $fval->getFieldDefinition()->getLabel();
              $value = $fval->getFieldDefinition()->getType() === 'entity_reference'
                ? $fval->entity->label()
                : $fval->value;

              $fields[$label] = $value;
            }

            $attributes_data[] = [
              'bundle' => $bundle_label,
              'fields' => $fields,
            ];
          }
        }

        $quotation_item_data[] = [
          'product_title' => $product_title,
          'unit_price' => $unit_price,
          'quantity' => $quantity,
          'total' => $total,
          'nid' => $item->id(),
          'attributes' => $attributes_data,
        ];
      }


      // ✅ Assign once outside loop
      $variables['quotation_item_data_2'] = $quotation_item_data;
      $variables['customer_user'] = $user;
      $variables['customer_profile'] = $profile;
    }

    // ---- Load Inventory Logs ----
    $inventory_logs = \Drupal::entityTypeManager()
      ->getStorage('node')
      ->loadByProperties([
        'type' => 'inventory_transaction_log',
        'field_purchase_order' => $node->id(),
      ]);

    $log_data = [];
    $grand_total = 0;

    foreach ($inventory_logs as $log) {
      $item = $log->get('field_inventory_item')->entity;
      if (!$item) continue;

      $cost = (float) ($item->get('field_cost_price')->value ?? 0);
      $qty = (float) ($log->get('field_quantity')->value ?? 0);
      $total = $cost * $qty;
      $grand_total += $total;

      $log_data[] = [
        'id' => $log->id(),
        'item_name' => $item->label(),
        'opening_stock' => $item->get('field_opening_stock')->value ?? '',
        'unit_of_measure' => $item->get('field_unit_of_measure')->entity->label() ?? '',
        'cost_price' => $cost,
        'quantity' => $qty,
        'total' => $total,
      ];
    }

    $variables['inventory_logs'] = $log_data;
    $variables['inventory_total'] = $grand_total;

    // ---- Load Work Orders ----
    $work_orders_data = [];
    $work_orders = \Drupal::entityTypeManager()
      ->getStorage('node')
      ->loadByProperties([
        'type' => 'work_order',
        'field_linked_quotation' => $node->id(),
      ]);

    foreach ($work_orders as $wo) {
      $line_item_label = '';
      $unit_label = '';
      $qty = (float) ($wo->get('field_quantity')->value ?? 0);
      $remarks = $wo->get('body')->value ?? '';
      $order_status = '';

      // Line item
      if ($wo->hasField('field_linked_line_item') && !$wo->get('field_linked_line_item')->isEmpty()) {
        $linked_item = $wo->get('field_linked_line_item')->entity;
        if ($linked_item) {
          $line_item_label = $linked_item->label();
        }
      }

      // Unit
      if ($wo->hasField('field_unit_assigned') && !$wo->get('field_unit_assigned')->isEmpty()) {
        $unit_term = $wo->get('field_unit_assigned')->entity;
        if ($unit_term) {
          $unit_label = $unit_term->label();
        }
      }

      // ✅ Order Status (safe check)
      if ($wo->hasField('field_order_status') && !$wo->get('field_order_status')->isEmpty()) {
        $term = $wo->get('field_order_status')->entity;
        if ($term) {
          $order_status = $term->label();
        }
      }
      $serial = $wo->get('field_work_order_number')->value ?? '';
      $expected_due = $wo->get('field_expected_due_date')->value ?? '';
      $wo_title = $wo->label();

      $work_orders_data[] = [
        'id' => $wo->id(),
        'title' => $wo_title,
        'serial' => $serial,
        'line_item' => $line_item_label,
        'unit' => $unit_label,
        'quantity' => $qty,
        'remarks' => $remarks,
        'expected_due' => $expected_due,
        'order_status' => $order_status,
      ];
    }

    $variables['work_orders'] = $work_orders_data;

    // Fetch linked Payment Records.
    $query = \Drupal::entityQuery('node')
      ->accessCheck(TRUE)
      ->condition('type', 'payment_record')
      ->condition('field_reference_order', $node->id())
      ->condition('status', 1);
    $pids = $query->execute();

    $payments = [];
    $total_paid = 0;

    if (!empty($pids)) {
      $payment_nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($pids);

      foreach ($payment_nodes as $pay_node) {
        $amount = (float) $pay_node->get('field_amount_paid')->value ?? 0;
        $total_paid += $amount;

        $payments[] = [
          'id' => $pay_node->id(),
          'date' => $pay_node->get('field_payment_date')->value ? date('d M Y', strtotime($pay_node->get('field_payment_date')->value)) : '-',
          'amount_paid' => number_format($amount, 2),
          'mode' => $pay_node->get('field_payment_mode')->entity->label() ?? '-',
          'serial' => $pay_node->get('field_payment_id')->value ?? '-',
          'remarks' => $pay_node->get('body')->value ?? '',
        ];
      }
    }

    // Get totals from the quotation node.
    $total_amount = (float) $node->get('field_total_amount')->value ?? 0;
    $amount_due = max(0, $total_amount - $total_paid);

    // Pass to Twig.
    $variables['payments'] = $payments;
    $variables['total_paid'] = number_format($total_paid, 2);
    $variables['total_amount'] = number_format($total_amount, 2);
    $variables['amount_due'] = number_format($amount_due, 2);


    // Attach JS
    $variables['#attached']['library'][] = 'stitchlyn_theme/inventory_log';
    $variables['#attached']['drupalSettings']['quotationId'] = $node->id();
    $variables['#cache']['max-age'] = 0;
    \Drupal::service('page_cache_kill_switch')->trigger();
  }


}

function stitchlyn_theme_preprocess_views_view(&$variables) {
  if ($variables['view']->id() === 'vendors' && $variables['view']->current_display === 'page_1') {
    $variables['export_query'] = \Drupal::request()->getQueryString();
  }
  if ($variables['view']->id() === 'products' && $variables['view']->current_display === 'page_2') {
    $variables['export_query'] = \Drupal::request()->getQueryString();
  }
  if ($variables['view']->id() === 'inventory_list' && $variables['view']->current_display === 'page_1') {
    $variables['export_query'] = \Drupal::request()->getQueryString();
  }
  if ($variables['view']->id() === 'inventory_log' && $variables['view']->current_display === 'page_1  ') {
    $variables['export_query'] = \Drupal::request()->getQueryString();
  }
  if ($variables['view']->id() === 'purchase_orders' && $variables['view']->current_display === 'page_1') {
    $variables['export_query'] = \Drupal::request()->getQueryString();
  }
  if ($variables['view']->id() === 'quotation_list' && $variables['view']->current_display === 'page_1') {
    $variables['export_query'] = \Drupal::request()->getQueryString();
  }
  if ($variables['view']->id() === 'unit_managers' && $variables['view']->current_display === 'page_2') {
    $variables['export_query'] = \Drupal::request()->getQueryString();
  }
  if ($variables['view']->id() === 'work_order' && $variables['view']->current_display === 'page_1  ') {
    $variables['export_query'] = \Drupal::request()->getQueryString();
  }
}

/**
 * Implements hook_page_attachments().
 */
function stitchlyn_theme_page_attachments(array &$attachments) {
  $current_path = \Drupal::service('path.current')->getPath();
  $route_match = \Drupal::routeMatch();
  $current_user = \Drupal::currentUser();

  // Check if path starts with /dashboard.
  if (preg_match('#^/dashboard#', $current_path)) {

    // If user does NOT have administrator role.
    if (!$current_user->hasRole('administrator')) {

      // Add message.
      \Drupal::messenger()->addError('You are not authorised to access the backend pages.');

      // Redirect to home page.
      $url = Url::fromRoute('<front>')->toString();
      $response = new TrustedRedirectResponse($url);
      $response->send();
      exit();
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for header.html.twig.
 */
function stitchlyn_theme_preprocess_header(&$variables) {
  \Drupal::logger('custom')->notice('Preprocess header called.');
  $account = \Drupal::currentUser();

  if ($account->isAuthenticated()) {
    $user = \Drupal\user\Entity\User::load($account->id());

    if ($user->hasField('user_picture') && !$user->get('user_picture')->isEmpty()) {
      $image = $user->get('user_picture')->entity;

      if ($image instanceof File) {
        $uri = $image->getFileUri();
        $file_url_generator = \Drupal::service('file_url_generator');

        $variables['user_picture_url'] = $file_url_generator->generateAbsoluteString($uri);
      }
    }
  }
  else {
    $variables['user_picture_url'] = '';
  }
}