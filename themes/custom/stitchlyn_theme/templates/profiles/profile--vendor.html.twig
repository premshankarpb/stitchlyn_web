{#
  profile--vendor.html.twig
  Pretty card layout for the Vendor profile type.

  Assumes field machine names (from your screenshot):
  - field_vendor_name (Text)
  - field_contact_person (Text)
  - field_phone_number (Phone)
  - field_gst_number (Text)
  - field_billing_address (Text long)
  - field_status (Taxonomy term: Status)

  Uses custom route: stitchlyn_basic.profile_form
#}

{%
  set left_classes = [
    'profile',
    'profile--' ~ profile.id,
    'profile--type--' ~ profile.bundle|clean_class,
    profile.isDefault() ? 'profile--is-default',
    view_mode ? 'profile--view-mode--' ~ view_mode|clean_class,
    'clearfix',
    'col-md-7',
    'col-lg-8'
  ]
%}

<div class="row g-4 mb-5">
  {# ===== Left: Vendor details ===== #}
  <div{{ attributes.addClass(left_classes) }}>
    {{ title_suffix.contextual_links }}

    {% set owner_id = profile.getOwnerId() %}

    <div class="card h-100 shadow-sm border-0">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <h5 class="card-title mb-0">Vendor Profile</h5>

          <a
            href="{{ path('stitchlyn_basic.profile_form', {'user': owner_id, 'profile_type': 'vendor'}) }}"
            class="btn btn-sm btn-primary"
            title="Edit Vendor Profile"
          >
            <i class="fas fa-pen me-1" aria-hidden="true"></i> Edit
          </a>
        </div>

        <ul class="list-group list-group-flush">

          {# Vendor Name #}
          {% if content.field_vendor_name is defined and content.field_vendor_name %}
            <li class="list-group-item">
              <i class="fas fa-store text-primary me-2" aria-hidden="true"></i>
              <strong>Vendor Name:</strong>
              {{ content.field_vendor_name }}
            </li>
          {% endif %}

          {# Contact Person #}
          {% if content.field_contact_person is defined and content.field_contact_person %}
            <li class="list-group-item">
              <i class="fas fa-user-tie text-primary me-2" aria-hidden="true"></i>
              <strong>Contact Person:</strong>
              {{ content.field_contact_person }}
            </li>
          {% endif %}

          {# Phone #}
          {% if content.field_phone_number is defined and content.field_phone_number %}
            <li class="list-group-item">
              <i class="fas fa-phone text-primary me-2" aria-hidden="true"></i>
              <strong>Phone:</strong>
              {{ content.field_phone_number }}
            </li>
          {% endif %}

          {# GST #}
          {% if content.field_gst_number is defined and content.field_gst_number %}
            <li class="list-group-item">
              <i class="fas fa-file-invoice-dollar text-primary me-2" aria-hidden="true"></i>
              <strong>GST Number:</strong>
              {{ content.field_gst_number }}
            </li>
          {% endif %}

          {# Status (taxonomy term) #}
          {% if content.field_status is defined and content.field_status %}
            <li class="list-group-item">
              <i class="fas fa-circle-check text-primary me-2" aria-hidden="true"></i>
              <strong>Status:</strong>
              {{ content.field_status }}
            </li>
          {% endif %}

          {# Billing Address #}
          {% if content.field_billing_address is defined and content.field_billing_address %}
            <li class="list-group-item">
              <i class="fas fa-map-marker-alt text-primary me-2" aria-hidden="true"></i>
              <strong>Billing Address:</strong>
              <div class="mt-1">{{ content.field_billing_address }}</div>
            </li>
          {% endif %}
        </ul>

        {# Print any remaining fields so nothing is lost #}
        {% set printed = [
          'field_vendor_name',
          'field_contact_person',
          'field_phone_number',
          'field_gst_number',
          'field_status',
          'field_billing_address',
          'field_remarks'
        ] %}

        {% set rest = content|without(printed) %}
        {% if rest|render %}
          <div class="mt-3">
            {{ rest }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {# ===== Right: About Vendor / Notes ===== #}
  <div class="col-md-5 col-lg-4">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title mb-3 text-center">About Vendor</h5>
        <p class="mb-4 container-fluid">
          {% if content.field_remarks is defined and content.field_remarks %}
            {{ content.field_remarks }}
          {% endif %}
        </p>
      </div>
    </div>
  </div>
</div>
