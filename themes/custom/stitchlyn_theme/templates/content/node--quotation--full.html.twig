{{ attach_library('stitchlyn_theme/bootstrap_js') }}
{{ attach_library('stitchlyn_theme/work_order') }}
{{ attach_library('stitchlyn_theme/inventory_log') }}
{{ attach_library('stitchlyn_theme/payment_record') }}

<article
	class="quotation-detail">

	{# Payment badge #}
	{% if node.field_payment_status.entity.label == 'Paid' %}
		{% set pay_class = 'bg-success' %}
	{% else %}
		{% set pay_class = 'bg-danger' %}
	{% endif %}

	<main
		class="admin-main">
		{# ---- Tabs ---- #}
		<ul class="nav nav-tabs mb-4" id="quotationTabs" role="tablist">
			<li class="nav-item" role="presentation">
				<button class="nav-link active" id="quotation-tab" data-bs-toggle="tab" data-bs-target="#quotationTabContent" type="button" role="tab" aria-controls="quotationTabContent" aria-selected="true">
					Quotation Details
				</button>
			</li>
			<li class="nav-item {{ attributes.class }}" role="presentation">
				<button class="nav-link" id="inventory-tab" data-bs-toggle="tab" data-bs-target="#inventoryTabContent" type="button" role="tab" aria-controls="inventoryTabContent" aria-selected="false">
					Inventory Logs
				</button>
			</li>
			<li class="nav-item {{ attributes.class }}" role="presentation">
				<button class="nav-link" id="workorder-tab" data-bs-toggle="tab" data-bs-target="#workOrdersTabContent" type="button" role="tab" aria-controls="workOrdersTabContent" aria-selected="false">
					Work Orders
				</button>
			</li>
			<li class="nav-item" role="presentation">
				<button class="nav-link" id="payment-tab" data-bs-toggle="tab" data-bs-target="#paymentTabContent" type="button" role="tab" aria-controls="paymentTabContent" aria-selected="false">
					Payment Records
				</button>
			</li>
		</ul>

		<div
			class="tab-content" id="quotationTabsContent {{ attributes.id }}">

			{# ================= TAB 1 : QUOTATION DETAILS ================= #}
			<div class="tab-pane fade show active" id="quotationTabContent" role="tabpanel" aria-labelledby="quotation-tab">
				<div class="mb-4 d-flex justify-content-between align-items-center">
					<div>
						<h1 class="display-5 fw-bold text-primary mb-3">{{ node.label }}</h1>
						<span class="badge {{ pay_class }}">{{ node.field_payment_status.entity.label }}</span>
					</div>
					<a href="{{ path('stitchlyn_quotation.pdf', {'node': node.id}) }}" class="btn btn-danger">
						Export PDF
					</a>
				</div>

				{# Summary cards #}
				<div class="row g-4 mb-5 align-items-stretch">
					<div class="col-md-6 col-lg-5">
						<div class="card shadow-sm h-100">
							<div class="card-body">
								<h5 class="card-title mb-3">{{ node.label }}
									Details</h5>
								<span class="badge {{ pay_class }} mb-3">
									Payment Status:
									{{ node.field_payment_status.entity.label }}
								</span>
								{% set due_date_value = node.field_expected_due_date.0.value %}
								<ul class="list-group list-group-flush">
									<li class="list-group-item">
										<strong>Date:</strong>
										{{ node.created.value|date('d M Y') }}</li>
									<li class="list-group-item">
										<strong>Due Date:</strong>
										{{ due_date_value|date('d M Y') }}</li>
									<li class="list-group-item">
										<strong>Customer:</strong>
										{{ node.field_customer_reference.entity.label }}</li>
									<li class="list-group-item">
										<strong>Subtotal Amount:</strong>
										₹
										{{ node.field_subtotal_amount.value }}</li>
									<li class="list-group-item">
										<strong>Tax Amount:</strong>
										₹
										{{ node.field_tax_amount.value }}</li>
									<li class="list-group-item">
										<strong>Total Amount:</strong>
										₹
										{{ node.field_total_amount.value }}</li>
								</ul>
							</div>
						</div>
					</div>

					<div class="col-md-6 col-lg-7">
						<div class="col-md-12 mb-3">
							<div class="card shadow-sm h-100">
								<div class="card-body remarks-card" style="max-height:420px;overflow-y:auto;">
									{% if node.body.value is not empty %}
										<h5 class="card-title mb-3">Remarks</h5>
										<p>{{ node.body.value|raw }}</p>
									{% endif %}

								</div>
							</div>
						</div>
						<div class="col-md-12 mb-3">
							<div class="card shadow-sm h-100">
								<div class="card-body remarks-card" style="max-height:420px;overflow-y:auto;">
									{% if customer_profile.field_remarks.value is not empty %}
										<h5 class="card-title mb-3">About Customer</h5>
										<p>{{ customer_profile.field_remarks.value|raw }}</p>
									{% endif %}

									<div class="mt-4">
										<button class="btn btn-primary me-2" onclick="showPhone()">Contact Customer</button>
										<span id="vendor-phone" style="display:none;">
											{{ customer_profile.field_phone_number.0.phone_number }}
										</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<hr>

				{# ================= Items table (WITH View button) ================= #}
				<h3>Items in this Quotation</h3>
				{% if quotation_item_data_2|length > 0 %}
					<table class="table table-bordered table-striped align-middle">
						<thead class="table-light">
							<tr>
								<th>Product Name</th>
								<th>Unit Price</th>
								<th>Quantity</th>
								<th>Total</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
							{% for item in quotation_item_data_2 %}
								<tr>
									<td>{{ item.product_title }}</td>
									<td>₹{{ item.unit_price }}</td>
									<td>{{ item.quantity }}</td>
									<td>₹{{ item.total }}</td>
									<td>
										<button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#itemModal{{ loop.index }}">
											View
										</button>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>

					{# --------- PER-ITEM MODALS (keep after the table) --------- #}
					{% for item in quotation_item_data_2 %}
						<div class="modal fade" id="itemModal{{ loop.index }}" tabindex="-1" aria-labelledby="itemModalLabel{{ loop.index }}" aria-hidden="true">
							<div class="modal-dialog modal-dialog-centered modal-lg">
								<div class="modal-content">
									<div class="modal-header bg-light">
										<h5 class="modal-title fw-bold" id="itemModalLabel{{ loop.index }}">
											Item Details –
											{{ item.product_title }}
										</h5>
										<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
									</div>
									<div class="modal-body">

										<table class="table table-bordered mb-0">
											<tbody>
												<tr>
													<th style="width:35%;">Product</th>
													<td>{{ item.product_title }}</td>
												</tr>
												<tr>
													<th>Quantity</th>
													<td>{{ item.quantity }}</td>
												</tr>
												<tr>
													<th>Unit Price</th>
													<td>₹{{ item.unit_price }}</td>
												</tr>
												<tr>
													<th>Total</th>
													<td>₹{{ item.total }}</td>
												</tr>
												<tr>
													<th>Linked Quotation</th>
													<td>{{ node.label }}</td>
												</tr>
											</tbody>
										</table>

										{% if item.attributes is defined and item.attributes|length > 0 %}
											<h5 class="mt-4 mb-2 fw-bold text-primary">Attributes</h5>
											{% for attr in item.attributes %}
												<table class="table table-sm table-striped mb-4">
													<thead class="table-light">
														<tr>
															<th colspan="2">{{ attr.bundle }}</th>
														</tr>
													</thead>
													<tbody>
														{% for label, value in attr.fields %}
															<tr>
																<td>{{ label }}</td>
																<td>{{ value }}</td>
															</tr>
														{% endfor %}
													</tbody>
												</table>
											{% endfor %}
										{% endif %}
									</div>
								</div>
							</div>
						</div>
					{% endfor %}

				{% else %}
					<p>No items found in this quotation.</p>
				{% endif %}
			</div>

			{# ================= TAB 2 : INVENTORY LOGS ================= #}
			<div class="tab-pane fade" id="inventoryTabContent" role="tabpanel" aria-labelledby="inventory-tab">
				<div class="inventory-section mt-4">
					<div class="d-flex justify-content-between align-items-center mb-3">
						<h4>Inventory Logs</h4>
						{% if not node.field_processed.value %}
							<button id="add-inventory-log" class="btn btn-success btn-sm">+ Add Log</button>
						{% endif %}
					</div>

					{% if inventory_logs|length > 0 %}
						<table class="table table-bordered table-striped align-middle">
							<thead class="table-light">
								<tr>
									<th>Inventory Item</th>
									<th>Current Stock</th>
									<th>Unit of Measure</th>
									<th>Cost Price</th>
									<th>Quantity</th>
									<th>Total</th>
									<th>Action</th>
								</tr>
							</thead>
							<tbody>
								{% for log in inventory_logs %}
									<tr>
										<td>{{ log.item_name }}</td>
										<td>{{ log.opening_stock }}</td>
										<td>{{ log.unit_of_measure }}</td>
										<td>₹{{ log.cost_price }}</td>
										<td>{{ log.quantity }}</td>
										<td>₹{{ log.total }}</td>
										<td>
											<button class="btn btn-outline-danger btn-sm remove-log" data-id="{{ log.id }}">Remove</button>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>

						<div class="text-end fw-bold fs-5 mt-2">
							Total Cost: ₹<span id="inventory-total-sum">{{ inventory_total }}</span>
						</div>

					{% else %}
						<p>No inventory logs found.</p>
					{% endif %}
				</div>
			</div>

			{# ================= TAB 3 : WORK ORDERS ================= #}
			<div class="tab-pane fade" id="workOrdersTabContent" role="tabpanel" aria-labelledby="work-orders-tab">
				<div class="workorder-section mt-4">
					<div class="d-flex justify-content-between align-items-center mb-3">
						<h4>Work Orders</h4>
						<button id="add-workorder" class="btn btn-success btn-sm">+ Add Work Order</button>
					</div>

					{# Wrapper for dynamic table replacement #}
					<div id="workorder-wrapper">
						{% if work_orders|length > 0 %}
							<table class="table table-bordered table-striped align-middle" id="workorder-table">
								<thead class="table-light">
									<tr>
										<th>Work Order #</th>
										<th>Linked Line Item</th>
										<th>Unit Assigned</th>
										<th>Date of Completion</th>
										<th>Assignee</th>
										<th>Quantity</th>
										<th>Expected Due Date</th>
										<th>Status</th>
										<th>Actions</th>
									</tr>
								</thead>
								<tbody>
									{% for wo in work_orders %}
										<tr>
											<td>{{ wo.title }}</td>
											<td>{{ wo.line_item }}</td>
											<td>{{ wo.unit }}</td>
											<td>{{ wo.date_of_completion }}</td>
											<td>{{ wo.assignee }}</td>
											<td>{{ wo.quantity }}</td>
											<td>{{ wo.expected_due }}</td>
											<td>{{ wo.order_status }}</td>
											<td>
												<button class="btn btn-outline-primary btn-sm view-workorder" data-id="{{ wo.id }}">View</button>
												<button class="btn btn-outline-secondary btn-sm edit-workorder" data-id="{{ wo.id }}">Edit</button>
												<a href="/node/add/order_logs?workorder={{ wo.id }}" target="_blank" class="btn btn-outline-success">Add Logs</a>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						{% else %}
							<p>No work orders found.</p>
						{% endif %}
					</div>
				</div>
			</div>


			{# ================= TAB 4 : PAYMENT RECORDS ================= #}
			<div class="tab-pane fade" id="paymentTabContent" role="tabpanel" aria-labelledby="payment-tab">
				<div class="payment-section mt-4">
					<div class="d-flex justify-content-between align-items-center mb-3">
						<h4>Payment Records</h4>
						{% if is_admin %}
							<a href="/dashboard/payments/add" target="_blank">
								<button id="add-payment" class="btn btn-success btn-sm" data-once="payAdd">+ Add Payment</button>
							</a>
						{% endif %}
					</div>

					<div id="payment-wrapper">
						{% if payments %}
							{# --- Payment Summary Table --- #}
							<table class="table table-bordered table-sm mb-4">
								<thead class="table-light">
									<tr class="text-center fw-bold">
										<th>Total Amount</th>
										<th>Amount Paid</th>
										<th>Amount Due</th>
									</tr>
								</thead>
								<tbody>
									<tr class="text-center fs-5">
										<td class="fw-bold text-primary">₹{{ total_amount }}</td>
										<td class="fw-bold text-success">₹{{ total_paid }}</td>
										<td class="fw-bold text-danger">₹{{ amount_due }}</td>
									</tr>
								</tbody>
							</table>

							{# --- Payment List Table --- #}
							<table class="table table-bordered table-striped align-middle">
								<thead class="table-light">
									<tr>
										<th>Date</th>
										<th>Amount Paid</th>
										<th>Mode</th>
										<th>Payment ID</th>
										<th>Remarks</th>
									</tr>
								</thead>
								<tbody>
									{% for pay in payments %}
										<tr>
											<td>{{ pay.date }}</td>
											<td>₹{{ pay.amount_paid }}</td>
											<td>{{ pay.mode }}</td>
											<td>{{ pay.serial }}</td>
											<td>{{ pay.remarks|raw }}</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>

							<div class="text-end fw-bold fs-5 mt-2">
								Total Paid: ₹<span id="payment-total">{{ total_paid }}</span>
							</div>
						{% else %}
							<p class="text-muted">No payments recorded.</p>
						{% endif %}
					</div>

				</div>
			</div>

			{# ================= Add Work Order Modal ================= #}
			<div class="modal fade" id="workOrderModal" tabindex="-1" aria-labelledby="workOrderModalLabel" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered modal-md">
					<div class="modal-content">
						<div class="modal-header bg-light">
							<h5 class="modal-title fw-bold" id="workOrderModalLabel">Add Work Order</h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>
						<div class="modal-body">
							<div class="mb-3">
								<label for="wo-line-item" class="form-label fw-bold">Linked Line Item</label>
								<input type="text" id="wo-line-item" class="form-control" placeholder="Start typing..." data-autocomplete-path="/quotation/{{ node.id }}/line-item/autocomplete">
							</div>

							<div class="mb-3">
								<label for="wo-unit" class="form-label fw-bold">Production Unit</label>
								<!-- <input type="text" id="wo-unit" class="form-control" placeholder="Start typing..." data-autocomplete-path="/production-unit/autocomplete"> -->
								<select id="wo-unit" class="form-select">
									<option value="">Select Unit</option>
									{% for units in production_units %}
										<option value="{{ units.value }}">{{ units.label }}</option>
									{% endfor %}
								</select>
							</div>

							<div class="mb-3">
								<label for="wo-quantity" class="form-label fw-bold">Quantity Assigned</label>
								<input type="number" id="wo-quantity" class="form-control" min="1" step="1">
							</div>

							<div class="mb-3">
								<label for="wo-due-date" class="form-label fw-bold">Expected Due Date</label>
								<input type="date" id="wo-due-date" class="form-control">
							</div>

							<div class="mb-3">
								<label for="wo-date-of-completion" class="form-label fw-bold">Date of Completion</label>
								<input type="date" id="wo-date-of-completion" class="form-control">
							</div>

							<div class="mb-3">
								<label for="wo-assignee" class="form-label fw-bold">Assignee</label>
								<select id="wo-assignee" class="form-select">
									<option value="">Select Assignee</option>
									{% for assignee in assignees %}
										<option value="{{ assignee.value }}">{{ assignee.label }}</option>
									{% endfor %}
								</select>
							</div>

							<div class="mb-3">
								<label for="wo-status" class="form-label fw-bold">Order Status</label>
								<!-- <input type="text" id="wo-status" class="form-control" placeholder="Start typing status..." data-autocomplete-path="/order-status/autocomplete"> -->
								<select id="wo-status" class="form-select">
									<option value="">Select Status</option>
									{% for order_status in order_statuses %}
										<option value="{{ order_status.value }}">{{ order_status.label }}</option>
									{% endfor %}
								</select>
							</div>

							<div class="mb-3">
								<label for="wo-remarks" class="form-label fw-bold">Remarks</label>
								<textarea id="wo-remarks" class="form-control" rows="3"></textarea>
							</div>

							<div class="text-end">
								<button type="button" id="wo-save" class="btn btn-primary">Save Work Order</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			{# ================= View Work Order Modal ================= #}
			<div class="modal fade" id="workOrderViewModal" tabindex="-1" aria-labelledby="workOrderViewModalLabel" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered modal-md">
					<div class="modal-content">
						<div class="modal-header bg-light">
							<h5 class="modal-title fw-bold" id="workOrderViewModalLabel">Work Order Details</h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>

						<div class="modal-body">
							<table class="table table-bordered table-striped mb-0">
								<tbody>
									<tr>
										<th>Work Order #</th>
										<td id="view-wo-title">—</td>
									</tr>
									<tr>
										<th>Linked Line Item</th>
										<td id="view-wo-line-item">—</td>
									</tr>
									<tr>
										<th>Production Unit</th>
										<td id="view-wo-unit">—</td>
									</tr>
									<tr>
										<th>Quantity</th>
										<td id="view-wo-quantity">—</td>
									</tr>
									<tr>
										<th>Expected Due Date</th>
										<td id="view-wo-due">—</td>
									</tr>
									<tr>
										<th>Date of Completion</th>
										<td id="view-wo-date-of-completion">—</td>
									</tr>
									<tr>
										<th>Assignee</th>
										<td id="view-wo-assignee">—</td>
									</tr>
									<tr>
										<th>Status</th>
										<td id="view-wo-status">—</td>
									</tr>
									<tr>
										<th>Remarks</th>
										<td id="view-wo-remarks">—</td>
									</tr>
									<tr>
										<th>Order Logs</th>
										<td id="view-wo-logs">—</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>

			{# ================= Edit Work Order Modal ================= #}
			<div class="modal fade" id="workOrderEditModal" tabindex="-1" aria-labelledby="workOrderEditModalLabel" aria-hidden="true">
				<div class="modal-dialog modal-dialog-centered modal-md">
					<div class="modal-content">
						<div class="modal-header bg-light">
							<h5 class="modal-title fw-bold" id="workOrderEditModalLabel">Edit Work Order</h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>
						<div class="modal-body">
							<form id="workorder-edit-form">
								<div class="mb-3">
									<label class="form-label fw-bold">Work Order #</label>
									<input type="text" class="form-control" id="edit-wo-title" readonly>
								</div>
								<div class="mb-3">
									<label class="form-label fw-bold">Linked Line Item</label>
									<input type="text" class="form-control" id="edit-wo-line-item" readonly>
								</div>
								<div class="mb-3">
									<label class="form-label fw-bold">Production Unit</label>
									<input type="text" class="form-control" id="edit-wo-unit" readonly>
								</div>
								<div class="mb-3">
									<label class="form-label fw-bold">Quantity</label>
									<input type="text" class="form-control" id="edit-wo-quantity" readonly>
								</div>
								<div class="mb-3">
									<label class="form-label fw-bold">Expected Due Date</label>
									<input type="text" class="form-control" id="edit-wo-due" readonly>
								</div>

								<div class="mb-3">
									<label class="form-label fw-bold">Date of Completion</label>
									<input type="date" class="form-control" id="edit-wo-date-of-completion">
								</div>

								<div class="mb-3">
									<label class="form-label fw-bold">Order Assignee</label>
									<select class="form-select" id="edit-wo-assignee">
										<option value="">Select Assignee</option>
										{% for assignee in assignees %}
											<option value="{{ assignee.value }}">{{ assignee.label }}</option>
										{% endfor %}
									</select>
								</div>

								<div class="mb-3">
									<label class="form-label fw-bold">Order Status</label>
									<select class="form-select" id="edit-wo-status">
										<option value="To Do">To Do</option>
										<option value="In Progress">In Progress</option>
										<option value="Done">Done</option>
										<option value="Rejected">Rejected</option>
									</select>
								</div>

								<div class="mb-3">
									<label class="form-label fw-bold">Remarks</label>
									<textarea class="form-control" id="edit-wo-remarks" rows="3"></textarea>
								</div>
							</form>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
							<button type="button" class="btn btn-primary" id="save-wo-edit">Save Changes</button>
						</div>
					</div>
				</div>
			</div>

		</div>
	</main>
</article>

