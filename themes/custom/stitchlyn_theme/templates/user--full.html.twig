{#
  Custom user page layout:
  - Top card: user summary with Edit button
  - Below: profile sections injected by stitchlyn_basic (customer/vendor/unit manager)
#}

<main class="admin-main">

  {# ===== Header / User summary ===== #}
  <div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div>
      <h1 class="display-5 fw-bold text-primary mb-2">{{ elements['#account'].label }}</h1>

      {# Status badge #}
      {% if is_active %}
        <span class="badge bg-success me-2">Active</span>
      {% else %}
        <span class="badge bg-secondary me-2">Blocked</span>
      {% endif %}

      {# Roles badges #}
      {% if roles_labels is not empty %}
        {% for r in roles_labels %}
          <span class="badge bg-info text-dark me-1">{{ r }}</span>
        {% endfor %}
      {% endif %}
    </div>

    {# Edit user button #}
    <div class="text-end">
      <a class="btn btn-primary" href="{{ edit_url }}">
        <i class="fas fa-user-edit me-1" aria-hidden="true"></i> Edit User
      </a>
    </div>
  </div>

  {# ===== User details card ===== #}
  <div class="row g-4 mb-5">
    <div class="col-md-7 col-lg-8">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title mb-3">User Details</h5>
          <ul class="list-group list-group-flush">

            {# NEW: First and Last name #}
            {% if first_name %}
              <li class="list-group-item">
                <i class="fas fa-id-badge text-primary me-2" aria-hidden="true"></i>
                <strong>First Name:</strong> {{ first_name }}
              </li>
            {% endif %}
            {% if last_name %}
              <li class="list-group-item">
                <i class="fas fa-id-badge text-primary me-2" aria-hidden="true"></i>
                <strong>Last Name:</strong> {{ last_name }}
              </li>
            {% endif %}

            {% if email %}
              <li class="list-group-item">
                <i class="fas fa-envelope text-primary me-2" aria-hidden="true"></i>
                <strong>Email:</strong> {{ email }}
              </li>
            {% endif %}
            <li class="list-group-item">
              <i class="fas fa-calendar-alt text-primary me-2" aria-hidden="true"></i>
              <strong>Member Since:</strong> {{ member_since }}
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="col-md-5 col-lg-4">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title mb-3 text-center">About {{ usr_role }}</h5>
          {# NEW: Picture thumbnail that links to original #}
          {% if picture_thumb_url and picture_original_url %}
            <div class="mb-4 text-center">
              <a href="{{ picture_original_url }}" target="_blank" rel="noopener" class="d-inline-block">
                <img src="{{ picture_thumb_url }}" alt="User picture" class="img-thumbnail" /></a>
            </div>
          {% endif %}
          <p class="mb-4 container-fluid">
            {% if usr_role == 'Customer' %}
              Keep your profile updated to receive accurate quotations, track orders, and ensure smooth communication with our team.  
            {% elseif usr_role == 'Vendor' %}
              Maintain your business and contact details here to receive timely purchase orders, collaborate on deliveries, and improve vendor interactions.  
            {% elseif usr_role == 'Unit Manager' %}
              Update your unit profile to manage work orders efficiently, track progress, and coordinate with the team for on-time production.  
            {% else %}
              Manage your profile details below. You can create or edit your Customer, Vendor, and Unit Manager profiles as applicable. These profiles power quotations, work orders, and vendor interactions.
            {% endif %}
          </p>
        </div>
      </div>
    </div>
  </div>

  {# ===== Profile sections ===== #}
  {% if customer_profile_section %}
    <section class="mb-4">
      <div class="card h-100">
        <div class="row g-4 mb-5">
          {{ customer_profile_section }}
        </div>
      </div>
    </section>
  {% endif %}

  {% if vendor_profile_section %}
    <section class="mb-4">
      <div class="card h-100">
        <div class="row g-4">
          {{ vendor_profile_section }}
        </div>
      </div>
    </section>
  {% endif %}

  {% if unitmgr_profile_section %}
    <section class="mb-4">
      <div class="card h-100">
        <div class="row g-4">
          {{ unitmgr_profile_section }}
        </div>
      </div>
    </section>
  {% endif %}

</main>