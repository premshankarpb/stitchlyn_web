<header class="site-header">
  <nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
      <a class="navbar-brand" href="{{ path('<front>') }}">
        <i class="fa-solid fa-people-arrows"></i>StitchLyn
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        {# ---- Main Navigation (from Main menu) ---- #}
        {% if menus.main_menu %}
          <ul class="navbar-nav mx-auto">
            {{ menus.main_menu }}
          </ul>
        {% endif %}

        {# ---- User Account Menu (profile dropdown) ---- #}
        {% if menus.user_account %}
          <div class="profile-dropdown dropdown ms-lg-3">
            <a
              class="profile-avatar d-flex align-items-center justify-content-center rounded-circle"
              href="#"
              id="profileDropdown"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <i class="fas fa-user"></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
              {{ menus.user_account }}
            </ul>
          </div>
        {% endif %}
      </div>
    </div>
  </nav>
</header>