<header class="site-header">
  <nav class="navbar navbar-expand-lg fixed-top">
    <div class="container">
      <a class="navbar-brand" href="{{ path('<front>') }}">
        <i class="fa-solid fa-people-arrows"></i>StitchLyn
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        {# ---- Main Navigation (from Main menu) ---- #}
        {% if menus.main_menu %}
          <ul class="navbar-nav mx-auto">
            {{ menus.main_menu }}
          </ul>
        {% endif %}

        {# ---- User Account Menu (profile dropdown) ---- #}
        {% if logged_in and menus.user_account|render|trim is not empty %}
          <div class="profile-dropdown dropdown ms-lg-3">
            <a
              class="profile-avatar d-flex align-items-center justify-content-center rounded-circle"
              href="{{ user_id }}"
              id="profileDropdown"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              {% if current_user_entity.user_picture.value %}
                {% set user_picture_file = file_url(current_user_entity.user_picture.entity.uri.value) %}
                <img src="{{ user_picture_file }}" alt="{{ current_user_entity.getDisplayName() }}">
              {% else %}
                <i class="fas fa-user"></i>
              {% endif %}
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
              <li>
              <p class="dropdown-item"> <strong> Hi {{ current_user_entity.getDisplayName() }} </strong></p> </li>
              {{ menus.user_account }}
            </ul>
          </div>
        {% elseif not logged_in %}
          <div class="profile-dropdown ms-lg-3">
            <a class="btn btn-outline-primary px-3" href="{{ path('user.login') }}">
              <i class="fas fa-sign-in-alt me-1"></i> Log in
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </nav>
</header>